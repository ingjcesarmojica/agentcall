# TusAbogados.com - Variables de Entorno
# Copiar a .env y completar los valores

# ── LLM principal (OpenRouter / minimax-m3) ───────────────────────
LLM_PROVIDER=openrouter
LLM_MODEL=minimax/minimax-m3:free
OPENROUTER_API_KEY=tu_openrouter_api_key_aqui
OPENROUTER_MODEL=minimax/minimax-m3:free

# ── Gemini AI (fallback) ─────────────────────────────────────────────
GEMINI_API_KEY=tu_gemini_api_key_aqui

# ── Pinecone (RAG) ──────────────────────────────────────────────────
PINECONE_API_KEY=tu_pinecone_api_key_aqui

# ── Supabase (Base de datos) ────────────────────────────────────────
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_supabase_anon_key_aqui

# ── TTS ─────────────────────────────────────────────────────────────
TTS_VOICE=es-US-PalomaNeural

# ── Servidor ────────────────────────────────────────────────────────
PORT=5000
